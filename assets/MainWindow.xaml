<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="Root"
    Title="WinTool"
    Width="1120"
    Height="800"
    MinWidth="980"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BrushCanvas}" Foreground="{DynamicResource BrushInk}"
    FontFamily="Segoe UI"
   
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- One text size for the whole app. Only page titles and the app name are larger. -->
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">28</sys:Double>
    <SolidColorBrush x:Key="BrushCanvas" Color="#1B2230"/>
    <SolidColorBrush x:Key="BrushCard" Color="#262E40"/>
    <SolidColorBrush x:Key="BrushLine" Color="#3A445C"/>
    <SolidColorBrush x:Key="BrushInk" Color="#E8EDF7"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#A7B3C9"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#6C9BFF"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#2A3A5C"/>
    <SolidColorBrush x:Key="BrushOk" Color="#3DDC97"/>
    <SolidColorBrush x:Key="BrushOkSoft" Color="#17382E"/>
    <SolidColorBrush x:Key="BrushWarn" Color="#E6B15A"/>
    <SolidColorBrush x:Key="BrushWarnSoft" Color="#3A3120"/>
    <SolidColorBrush x:Key="BrushBad" Color="#B42318"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#141A27"/>
    <SolidColorBrush x:Key="BrushLog" Color="#121826"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#8BB0FF"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#4E86F5"/>
    <SolidColorBrush x:Key="BrushSidebarText" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="BrushSidebarMuted" Color="#93A0B8"/>
    <SolidColorBrush x:Key="BrushNavHover" Color="#2A3348"/>
    <SolidColorBrush x:Key="BrushLogText" Color="#D5DEEE"/>
    <SolidColorBrush x:Key="BrushProgress" Color="#6C9BFF"/>
    <SolidColorBrush x:Key="BrushProgressTrack" Color="#2A3348"/>
    <SolidColorBrush x:Key="BrushInput" Color="#1C2434"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#44506A"/>
    <SolidColorBrush x:Key="BrushHint" Color="#8E9BB3"/>
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushBadSoft" Color="#3A1D24"/>
    <SolidColorBrush x:Key="BrushOkLine" Color="#2F6B4A"/>
    <SolidColorBrush x:Key="BrushWarnLine" Color="#7A5A1E"/>
    <SolidColorBrush x:Key="BrushWarnStrong" Color="#D39B2A"/>
    <SolidColorBrush x:Key="BrushOnWarn" Color="#1B1B1B"/>

    <!-- Small rounded button used on app cards; colors are set per button. -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Width" Value="96"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource BrushNavHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Pill chips: filters on Install (radio) and presets on Tweaks (button). -->
    <Style x:Key="ChipRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="{DynamicResource BrushNavHover}" CornerRadius="16" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource BrushNavHover}" CornerRadius="16" Padding="12,0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{DynamicResource BrushNavHover}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- On/off switch for tweaks. An unknown state (IsChecked null) shows off and faded. -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="20" Background="Transparent">
              <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource BrushInputBorder}"/>
              <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The compact 30 x 15 switch used on each tweak row. -->
    <Style x:Key="SwitchToggleSmall" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="30" Height="15" Background="Transparent">
              <Border x:Name="Track" CornerRadius="7.5" Background="{DynamicResource BrushInputBorder}"/>
              <Ellipse x:Name="Knob" Width="11" Height="11" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushSidebarText}"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushCanvas}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushLogText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>



    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- Home: the gradient call to action, the row Fix/Review buttons and a text link. -->
    <LinearGradientBrush x:Key="BrushHomeGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4C8DFF" Offset="0"/>
      <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="HomeGradientButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{StaticResource BrushHomeGradient}" CornerRadius="9"/>
              <Border x:Name="Off" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="9" Visibility="Collapsed"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Off" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushHint}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HomeRowButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Width" Value="76"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HomeLinkButton" TargetType="Button">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource BrushAccentHover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource BrushHint}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
      <Setter Property="Padding" Value="9,0"/>
    </Style>
    <!-- Rounded checkbox: 20 px box, 1.5 px border, accent fill and a white
         check mark when ticked. No dotted focus rectangle. -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="20" Height="20" CornerRadius="5" VerticalAlignment="Center" Background="{DynamicResource BrushInput}" BorderBrush="{DynamicResource BrushMuted}" BorderThickness="1.5">
                <Grid>
                  <Path x:Name="Mark" Data="M 4.5,10 L 8.5,14 L 15.5,6.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="-1.5" Visibility="Collapsed"/>
                  <Rectangle x:Name="Dash" Width="9" Height="2" RadiusX="1" RadiusY="1" Fill="White" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Margin" Value="0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
              </MultiTrigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
              <Grid Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource BrushInputBorder}" StrokeThickness="1.5" Fill="{DynamicResource BrushInput}"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource BrushAccent}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource BrushMuted}" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
          <TextBlock x:Name="VersionText" Text="Version" Foreground="{DynamicResource BrushSidebarMuted}"/>
          <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource BrushSidebarText}" TextWrapping="Wrap">
            <Hyperlink x:Name="ProjectLink" Foreground="{DynamicResource BrushSidebarText}" NavigateUri="https://github.com/Hinrikao/WinTool">
              Hinrikao/WinTool
            </Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel Margin="16,22,16,0">
          <TextBlock Text="WinTool" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushSidebarText}"/>
          <TextBlock Text="A calm setup helper for a fresh Windows 11 PC." Foreground="{DynamicResource BrushSidebarMuted}" TextWrapping="Wrap" Margin="0,8,0,22"/>

          <RadioButton x:Name="NavHome" GroupName="WinToolNav" Style="{StaticResource NavButton}" IsChecked="True" AutomationProperties.Name="Home">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Home" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavInstall" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Install">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Install" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTweaks" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Tweaks">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTerminal" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Terminal">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Terminal" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavUpdates" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Drivers and updates">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Updates" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFixes" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Fixes">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Fixes" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFeatures" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Windows features">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Features" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavConfig" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Config">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Config" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <!-- Home: one fixed layout for analyzing, done and fixing. Only the
             content inside each slot changes; no state moves or resizes anything. -->
        <Grid x:Name="ViewHome">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="20,15,20,0">
            <TextBlock Text="Home" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="HomeRunText" Width="150" TextAlignment="Right" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text=" "/>
              <Button x:Name="HomeAgain" Content="Analyze again" Style="{StaticResource HomeLinkButton}" Width="104" Height="32" Margin="16,0,0,0"/>
            </StackPanel>
          </Grid>
          <ScrollViewer x:Name="HomeScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="HomeBody" Margin="20,0,20,16">
              <Grid.RowDefinitions>
                <RowDefinition Height="474"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*" MinHeight="150"/>
              </Grid.RowDefinitions>
              <Border x:Name="HomeHero" Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="16" Padding="22">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid x:Name="HomeRing" Grid.Column="0" Width="236" Height="236" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="236" Height="236" IsHitTestVisible="False">
                      <Ellipse Canvas.Left="-22" Canvas.Top="-22" Width="280" Height="280">
                        <Ellipse.Fill>
                          <RadialGradientBrush>
                            <GradientStop Color="#404C8DFF" Offset="0"/>
                            <GradientStop Color="#004C8DFF" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <Ellipse Canvas.Left="15" Canvas.Top="5" Width="250" Height="250">
                        <Ellipse.Fill>
                          <RadialGradientBrush>
                            <GradientStop Color="#308B5CF6" Offset="0"/>
                            <GradientStop Color="#008B5CF6" Offset="1"/>
                          </RadialGradientBrush>
                        </Ellipse.Fill>
                      </Ellipse>
                      <Ellipse Canvas.Left="19" Canvas.Top="19" Width="198" Height="198" StrokeThickness="10" Stroke="{DynamicResource BrushProgressTrack}"/>
                      <Ellipse Canvas.Left="40" Canvas.Top="40" Width="156" Height="156" Fill="{DynamicResource BrushCanvas}" Stroke="{DynamicResource BrushLine}" StrokeThickness="1"/>
                      <Path x:Name="HomeArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource BrushHomeGradient}"/>
                      <Ellipse x:Name="HomeArcCap" Width="12" Height="12" Fill="#FFFFFF">
                        <Ellipse.Effect>
                          <DropShadowEffect Color="#8B5CF6" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                      </Ellipse>
                    </Canvas>
                    <StackPanel x:Name="HomeRingBusy" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Width="22" Height="22" HorizontalAlignment="Center" Stroke="{DynamicResource BrushAccent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 9,2 A 7,7 0 1 1 8.99,2 M 14,14 L 20,20"/>
                      <TextBlock Text="ANALYZING" FontWeight="Bold" Foreground="{DynamicResource BrushInk}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                      <TextBlock x:Name="HomeRingProgress" Text="0 of 5 checks" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="HomeRingDone" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                      <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource BrushInk}">
                        <Run x:Name="HomeScore" Text="0" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"/><Run Text=" / 100" Foreground="{DynamicResource BrushMuted}"/>
                      </TextBlock>
                      <Border x:Name="HomeVerdict" Height="24" CornerRadius="12" Padding="10,0" Margin="0,6,0,0" HorizontalAlignment="Center" Background="{DynamicResource BrushWarnSoft}">
                        <TextBlock x:Name="HomeVerdictText" Text="Needs attention" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BrushWarn}"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                  <StackPanel x:Name="HomeInfo" Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="HomeHeadline" Height="20" Text="Analyzing your PC..." FontWeight="Bold" Foreground="{DynamicResource BrushInk}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeLead" Height="20" Margin="0,4,0,0" Text="Takes less than a minute. Nothing is changed during the analysis." Foreground="{DynamicResource BrushMuted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HomeMeta" Height="20" Margin="0,10,0,0" Foreground="{DynamicResource BrushHint}" TextTrimming="CharacterEllipsis"><Run x:Name="HomeMetaText" Text="No earlier analysis on this PC"/><Run Text=" &#183; "/><Hyperlink x:Name="HomeHistoryLink" Foreground="{DynamicResource BrushAccent}" TextDecorations="{x:Null}">View history</Hyperlink></TextBlock>
                    <Grid Height="32" Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Needs attention" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
                        <TextBlock x:Name="HomeCheckCount" Text="0 of 5 complete" Width="160" TextTrimming="CharacterEllipsis" Margin="10,0,0,0" Foreground="{DynamicResource BrushMuted}"/>
                      </StackPanel>
                      <Button x:Name="HomeFixAll" Grid.Column="2" Content="Fix all" Width="88" Height="32" Style="{StaticResource HomeGradientButton}" IsEnabled="False"/>
                    </Grid>
                    <Border Height="282" Margin="0,8,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BrushLine}" Background="{DynamicResource BrushCanvas}">
                      <StackPanel x:Name="HomeChecks"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid x:Name="HomeMinis" Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="ViewInstall" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="20,15,20,0">
            <TextBlock Text="Install" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource BrushInk}" VerticalAlignment="Center"/>
            <!-- Selection actions: on the title row, right side, only while apps are ticked. The title row is taller than the buttons, so nothing below moves. -->
            <StackPanel x:Name="AppBulkBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="AppCount" Text="0 selected" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource BrushInk}" Margin="0,0,12,0" TextWrapping="NoWrap"/>
              <Button x:Name="AppInstall" Content="Install selected" Style="{StaticResource CardButton}" Width="Auto" Height="32" Padding="14,0" Margin="0,0,6,0" Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushOnAccent}" FontWeight="SemiBold"/>
              <Button x:Name="AppUpdate" Content="Update selected" Style="{StaticResource CardButton}" Width="Auto" Height="32" Padding="14,0" Margin="0,0,6,0" Background="{DynamicResource BrushWarnStrong}" Foreground="{DynamicResource BrushOnWarn}"/>
              <Button x:Name="AppUninstall" Content="Uninstall selected" Style="{StaticResource CardButton}" Width="Auto" Height="32" Padding="14,0" Margin="0,0,6,0" Background="{DynamicResource BrushBadSoft}" Foreground="{DynamicResource BrushBad}"/>
              <Button x:Name="AppClear" Content="Clear" Style="{StaticResource ToolbarButton}" Height="32" Padding="14,0"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1" Margin="20,7,20,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Height="34" VerticalAlignment="Top">
              <TextBox x:Name="AppSearch" Style="{StaticResource PageSearch}" Height="34" AutomationProperties.Name="Search apps"/>
              <TextBlock x:Name="AppSearchHint" Text="Search apps&#x2026;" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushHint}"/>
            </Grid>
            <!-- The chips get the full width on their own row; below about 1280 px they scroll sideways (mouse wheel). -->
            <ScrollViewer x:Name="AppFilterScroll" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Height="34" VerticalAlignment="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <StackPanel x:Name="AppFilters" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
            <!-- Status of the installed-apps check, in the free space of the search row, so it never pushes the cards. -->
            <TextBlock x:Name="AppInstalledStatus" Grid.Column="1" Text="Installed apps not checked yet." Foreground="{DynamicResource BrushMuted}" Visibility="Hidden" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="AppUpgradeAll" Style="{StaticResource ToolbarButton}" Height="32" Padding="14,0" Margin="0,0,6,0" Content="Update all" ToolTip="Runs winget upgrade --all"/>
              <Button x:Name="AppRefreshInstalled" Style="{StaticResource ToolbarButton}" Width="32" Height="32" Padding="0" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" ToolTip="Check again which apps are installed and which have updates" AutomationProperties.Name="Refresh installed apps"/>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="2" Margin="20,6,20,0">
          </StackPanel>
          <ScrollViewer x:Name="AppScroll" Grid.Row="3" Margin="20,0,20,8" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock x:Name="AppEmpty" Text="No apps match that search." Foreground="{DynamicResource BrushMuted}" Margin="0,8,0,0" Visibility="Collapsed"/>
              <StackPanel x:Name="AppCategories"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="ViewTweaks" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="20,15,20,0" Text="Tweaks" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
          <Grid Grid.Row="1" Margin="20,7,20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Height="34">
              <TextBox x:Name="TweakSearch" Style="{StaticResource PageSearch}" Height="34" AutomationProperties.Name="Search tweaks"/>
              <TextBlock x:Name="TweakSearchHint" Text="Search tweaks&#x2026;" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushHint}"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,12,0">
              <TextBlock Text="Presets:" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <StackPanel x:Name="TweakPresets" Orientation="Horizontal" VerticalAlignment="Center"/>
            </StackPanel>
            <DockPanel Grid.Column="2" LastChildFill="True" VerticalAlignment="Center">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushOk}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Safe" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushWarn}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="Caution" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="TweakRestoreNote" Text="Restore point is created before the first change" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Grid>
          <ScrollViewer x:Name="TweakScroll" Grid.Row="2" Margin="20,10,20,8" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock x:Name="TweakEmpty" Text="No tweaks match that search." Foreground="{DynamicResource BrushMuted}" Margin="0,8,0,0" Visibility="Collapsed"/>
              <!-- Masonry columns, built in code from the available width. -->
              <Grid x:Name="TweakCategories"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Grid x:Name="ViewTerminal" Visibility="Collapsed" TextElement.FontSize="{DynamicResource FontSizeBody}">
          <Grid.Resources>
            <Style x:Key="TerminalCard" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="8"/>
              <Setter Property="Padding" Value="12"/>
            </Style>
            <Style x:Key="TerminalStep" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Margin" Value="0,0,8,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            </Style>
            <Style x:Key="TerminalCardTitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
            </Style>
            <Style x:Key="TerminalCount" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Margin" Value="8,0,0,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
            </Style>
            <Style x:Key="TerminalSearch" TargetType="TextBox" BasedOn="{StaticResource PageSearch}">
              <Setter Property="Padding" Value="30,0,9,0"/>
            </Style>
            <Style x:Key="TerminalHint" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Margin" Value="32,0,0,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="IsHitTestVisible" Value="False"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushHint}"/>
            </Style>
            <Style x:Key="TerminalGlyph" TargetType="TextBlock">
              <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- Simple / Advanced as one segmented control, 32 px tall. -->
            <Style x:Key="TerminalSegment" TargetType="RadioButton">
              <Setter Property="Foreground" Value="{DynamicResource BrushMuted}"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Height" Value="30"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="16,0">
                      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <!-- Rows in the prompt and theme lists: the accent border marks the choice. -->
            <Style x:Key="TerminalRow" TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Padding" Value="8,7"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Arrow"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="TerminalList" TargetType="ListBox">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
              <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
              <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
              <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
              <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
            </Style>
            <!-- A dark drop-down for the font and the size, as tall as a search box. -->
            <Style x:Key="TerminalComboToggle" TargetType="ToggleButton">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource BrushInput}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1" CornerRadius="6">
                      <TextBlock Text="&#xE70D;" Style="{StaticResource TerminalGlyph}" Margin="0,0,10,0" HorizontalAlignment="Right" Foreground="{DynamicResource BrushMuted}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="TerminalCombo" TargetType="ComboBox">
              <Setter Property="Height" Value="34"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
              <Setter Property="IsTextSearchEnabled" Value="True"/>
              <Setter Property="ItemsPanel">
                <Setter.Value>
                  <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                  </ItemsPanelTemplate>
                </Setter.Value>
              </Setter>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBox">
                    <Grid>
                      <ToggleButton Style="{StaticResource TerminalComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                      <ContentPresenter Margin="10,0,30,0" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                      <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="6" Padding="2" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                          <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                          </ScrollViewer>
                        </Border>
                      </Popup>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
            <Style x:Key="TerminalComboItem" TargetType="ComboBoxItem">
              <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,8">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Grid.Resources>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header: title, Simple / Advanced, and the promise that nothing changes yet. -->
          <DockPanel Grid.Row="0" Margin="20,15,20,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Terminal" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource BrushInk}"/>
            <Border DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Background="{DynamicResource BrushInput}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TerminalModeSimple" GroupName="TerminalMode" Content="Simple" IsChecked="True" Style="{StaticResource TerminalSegment}" ToolTip="A recommended setup in one click."/>
                <RadioButton x:Name="TerminalModeAdvanced" GroupName="TerminalMode" Content="Advanced" Style="{StaticResource TerminalSegment}" ToolTip="Choose the prompt, theme, font, color scheme, and extras."/>
              </StackPanel>
            </Border>
            <TextBlock DockPanel.Dock="Right" Text="Nothing changes until you press Apply" VerticalAlignment="Center" Foreground="{DynamicResource BrushMuted}"/>
          </DockPanel>
          <TextBlock x:Name="TerminalSubtitle" Grid.Row="1" Margin="20,6,20,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" Text="A recommended setup in one click. Switch to Advanced to choose each part."/>

          <ScrollViewer x:Name="TerminalSimpleScroll" Grid.Row="2" Margin="20,12,20,10" VerticalScrollBarVisibility="Visible">
            <StackPanel x:Name="TerminalSimpleHost"/>
          </ScrollViewer>

          <!-- Advanced: prompt engines | themes | preview with font and colors; extras under the last two.
               When the window is short the body scrolls instead of squeezing the cards. -->
          <ScrollViewer x:Name="TerminalBodyScroll" Grid.Row="2" Margin="20,12,20,10" Visibility="Collapsed" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="TerminalAdvancedHost">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TerminalColumnLeft" Width="230"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="TerminalColumnMiddle" Width="*"/>
                <ColumnDefinition x:Name="TerminalColumnGap" Width="12"/>
                <ColumnDefinition x:Name="TerminalColumnRight" Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition x:Name="TerminalRowMain" Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- 1. Prompt engine, grouped by the shell it runs in. -->
              <Border x:Name="TerminalCardPrompt" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource TerminalCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="108"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="1" Style="{StaticResource TerminalStep}"/>
                    <TextBlock x:Name="TerminalPromptCount" DockPanel.Dock="Right" MinWidth="90" TextAlignment="Right" Text="8 engines" Style="{StaticResource TerminalCount}"/>
                    <TextBlock Text="Prompt" Style="{StaticResource TerminalCardTitle}"/>
                  </DockPanel>
                  <ListBox x:Name="TerminalPromptList" Grid.Row="1" Style="{StaticResource TerminalList}" AutomationProperties.Name="Prompt engine"/>
                  <!-- Fixed height (name plus three lines), so picking an engine never resizes the list above. -->
                  <Border Grid.Row="2" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0" Height="99">
                    <StackPanel>
                      <TextBlock x:Name="TerminalPromptName" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="20" Height="20" Foreground="{DynamicResource BrushInk}"/>
                      <TextBlock x:Name="TerminalPromptAbout" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineStackingStrategy="BlockLineHeight" LineHeight="20" Height="60" Foreground="{DynamicResource BrushMuted}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <!-- 2. Theme, preset, or style of the chosen engine. -->
              <Border x:Name="TerminalCardTheme" Grid.Row="0" Grid.Column="2" Style="{StaticResource TerminalCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="132"/>
                  </Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="2" Style="{StaticResource TerminalStep}"/>
                    <TextBlock x:Name="TerminalThemeCount" DockPanel.Dock="Right" MinWidth="90" TextAlignment="Right" Text="" Style="{StaticResource TerminalCount}"/>
                    <TextBlock x:Name="TerminalThemeTitle" Text="Theme" Style="{StaticResource TerminalCardTitle}"/>
                  </DockPanel>
                  <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TerminalThemeSearch" Grid.Column="0" Style="{StaticResource TerminalSearch}" AutomationProperties.Name="Search prompt themes"/>
                    <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource TerminalGlyph}" Margin="10,0,0,0" IsHitTestVisible="False" Foreground="{DynamicResource BrushHint}"/>
                    <TextBlock x:Name="TerminalThemeSearchHint" Grid.Column="0" Text="Search themes&#x2026;" Style="{StaticResource TerminalHint}" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="TerminalRefresh" Grid.Column="1" Style="{StaticResource ChipButton}" Width="32" Margin="6,0,0,0" ToolTip="Refresh the Nerd Fonts and Oh My Posh lists from GitHub." AutomationProperties.Name="Refresh lists from GitHub">
                      <TextBlock Text="&#xE72C;" Style="{StaticResource TerminalGlyph}" Margin="-6,0"/>
                    </Button>
                  </Grid>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,2">
                    <RadioButton x:Name="TerminalFilterAll" GroupName="TerminalThemeFilter" Content="All" IsChecked="True" Style="{StaticResource ChipRadio}" Margin="0,0,6,6" Tag="all"/>
                    <RadioButton x:Name="TerminalFilterPowerline" GroupName="TerminalThemeFilter" Content="Powerline" Style="{StaticResource ChipRadio}" Margin="0,0,6,6" Tag="powerline" ToolTip="Themes drawn as colored blocks."/>
                    <RadioButton x:Name="TerminalFilterMinimal" GroupName="TerminalThemeFilter" Content="Minimal" Style="{StaticResource ChipRadio}" Margin="0,0,6,6" Tag="minimal" ToolTip="Plain colored text, no blocks."/>
                    <RadioButton x:Name="TerminalFilterNoNerd" GroupName="TerminalThemeFilter" Content="No Nerd Font" Style="{StaticResource ChipRadio}" Margin="0,0,0,6" Tag="no-nerd" ToolTip="No Nerd Font needed: themes that look right with any font."/>
                  </WrapPanel>
                  <Border Grid.Row="3" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BrushInput}" ClipToBounds="True">
                    <Grid>
                      <ListBox x:Name="TerminalStyleList" Style="{StaticResource TerminalList}" AutomationProperties.Name="Prompt theme"/>
                      <TextBlock x:Name="TerminalStyleNote" Text="Themes" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <!-- Right column: live preview, then font and colors. -->
              <Grid x:Name="TerminalSideColumn" Grid.Row="0" Grid.Column="4">
                <Grid.RowDefinitions>
                  <RowDefinition x:Name="TerminalRowPreview" Height="*" MinHeight="190"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="TerminalCardPreview" Grid.Row="0" Style="{StaticResource TerminalCard}" Padding="0" ClipToBounds="True" ToolTip="Live preview: sample output, not a real shell.">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Height="36" Background="{DynamicResource BrushSidebar}" CornerRadius="8,8,0,0" Padding="8,0,10,0">
                      <DockPanel LastChildFill="False">
                        <Border x:Name="TerminalPreviewTab" DockPanel.Dock="Left" Height="30" VerticalAlignment="Bottom" CornerRadius="6,6,0,0" Padding="12,0" Background="#1B2230">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" Style="{StaticResource TerminalGlyph}" Margin="0,0,8,0" Foreground="{DynamicResource BrushInk}"/>
                            <TextBlock x:Name="TerminalPreviewTabText" Text="PowerShell" VerticalAlignment="Center" Foreground="{DynamicResource BrushInk}"/>
                          </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="+   &#x2304;" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushMuted}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource BrushHint}">
                          <TextBlock Text="&#xE921;" Style="{StaticResource TerminalGlyph}" Margin="0,0,16,0"/>
                          <TextBlock Text="&#xE922;" Style="{StaticResource TerminalGlyph}" Margin="0,0,16,0"/>
                          <TextBlock Text="&#xE8BB;" Style="{StaticResource TerminalGlyph}"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <!-- The sample text uses the chosen terminal font size: it is content, not interface text. -->
                    <Border x:Name="TerminalFontPreview" Grid.Row="1" Background="#1B2230" Padding="14,10" ClipToBounds="True">
                      <TextBlock x:Name="TerminalFontSample" Text="Font preview" Typography.StandardLigatures="True" Typography.ContextualAlternates="True" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource BrushLogText}" TextWrapping="NoWrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BrushLine}" BorderThickness="0,1,0,0" Padding="12,8">
                      <TextBlock x:Name="TerminalPreviewInfo" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushMuted}"/>
                    </Border>
                  </Grid>
                </Border>

                <!-- 3. Font and colors. -->
                <Border x:Name="TerminalCardFont" Grid.Row="1" Style="{StaticResource TerminalCard}" Margin="0,12,0,0">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock DockPanel.Dock="Left" Text="3" Style="{StaticResource TerminalStep}"/>
                      <CheckBox x:Name="TerminalFontNerdOnly" DockPanel.Dock="Right" Content="Nerd Fonts only" IsChecked="True" Margin="8,0,0,0" AutomationProperties.Name="Nerd Fonts only" ToolTip="Nerd Fonts carry the icons that most prompt themes use."/>
                      <TextBlock Text="Font and colors" Style="{StaticResource TerminalCardTitle}"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                      </Grid.ColumnDefinitions>
                      <ComboBox x:Name="TerminalFontList" Grid.Column="0" Style="{StaticResource TerminalCombo}" ItemContainerStyle="{StaticResource TerminalComboItem}" MaxDropDownHeight="360" AutomationProperties.Name="Terminal font" ToolTip="Type a name to jump to it."/>
                      <ComboBox x:Name="TerminalFontSize" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource TerminalCombo}" ItemContainerStyle="{StaticResource TerminalComboItem}" AutomationProperties.Name="Font size"/>
                    </Grid>
                    <TextBlock x:Name="TerminalFontCount" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" Text=""/>
                    <UniformGrid x:Name="TerminalSchemeHost" Columns="4" Rows="1" Margin="0,0,-6,0"/>
                    <TextBlock x:Name="TerminalFontLigatureNote" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" Text="Font ligatures are always on in every Terminal profile." ToolTip="WinTool sets calt and liga in profiles.defaults.font.features in the Windows Terminal settings.json and keeps your other font features."/>
                  </StackPanel>
                </Border>
              </Grid>

              <!-- 4. Extras, under the theme list and the preview. -->
              <Border x:Name="TerminalCardExtras" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource TerminalCard}" Margin="0,12,0,0">
                <StackPanel>
                  <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="4" Style="{StaticResource TerminalStep}"/>
                    <TextBlock x:Name="TerminalExtrasCount" DockPanel.Dock="Right" MinWidth="90" TextAlignment="Right" Text="" Style="{StaticResource TerminalCount}"/>
                    <TextBlock Text="Extras" Style="{StaticResource TerminalCardTitle}"/>
                  </DockPanel>
                  <UniformGrid x:Name="TerminalExtrasHost" Columns="2" Margin="0,0,-16,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>

          <!-- Fixed action bar: what will be installed (+) and changed (~), then Apply. -->
          <Border x:Name="TerminalSummaryCard" Grid.Row="3" Margin="20,0,20,10" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="What will happen" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource BrushInk}"/>
              <CheckBox x:Name="TerminalEnabled" Grid.Row="0" Grid.Column="1" Content="Include in saved profiles" IsChecked="True" Margin="14,0,16,0" ToolTip="Include this terminal setup when a saved WinTool profile is replayed."/>
              <Button x:Name="TerminalSetup" Grid.Row="0" Grid.Column="2" Content="Apply terminal setup" Style="{StaticResource PrimaryButton}" FontSize="{DynamicResource FontSizeBody}" Width="190" Height="32" Padding="18,0" Margin="0" VerticalAlignment="Center"/>
              <!-- One line of chips, always 32 px tall: more chips scroll sideways (mouse wheel), the tooltip lists every step. -->
              <ScrollViewer x:Name="TerminalSummaryScroll" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0" Height="32" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TerminalSummaryHost" Orientation="Horizontal"/>
              </ScrollViewer>
              <TextBlock x:Name="TerminalSummary" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushMuted}"/>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer x:Name="ViewUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Visible">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Drivers and updates" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="WinTool uses Windows Update and links to the graphics vendor. It does not install driver cleaner or booster tools." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Graphics on this PC" FontWeight="SemiBold"/>
                <TextBlock x:Name="GpuSummary" Text="Looking up graphics adapters..." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <WrapPanel x:Name="VendorLinks"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Update mode" FontWeight="SemiBold"/>
                <TextBlock Text="Choose how Windows Update behaves on this PC. WinTool only writes Windows Update policies and service settings, and Default removes them all again." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="UpdateModeCurrent" Text="Current mode: checking..." FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel x:Name="UpdateModeList" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ApplyUpdateMode" Content="Apply mode" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="RevertUpdateMode" Content="Back to default" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Windows Update" FontWeight="SemiBold"/>
                <TextBlock Text="The scan lists driver updates Windows Update is offering right now. Optional updates are easier to review in Settings. Installing can take a while and may ask for a restart." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <CheckBox x:Name="IncludeSoftwareUpdates" Content="Include software updates, not only drivers" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="ScanDrivers" Content="Scan for updates" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="OpenWindowsUpdate" Content="Open Windows Update" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="OpenOptionalUpdates" Content="Open optional updates" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="InstallScannedUpdates" Content="Install scanned updates" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="UpdateEmpty" Text="No scan yet." Foreground="{DynamicResource BrushMuted}"/>
                <ListBox x:Name="UpdateList" BorderThickness="0" Background="Transparent" MaxHeight="220" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewFixes" Visibility="Collapsed" VerticalScrollBarVisibility="Visible">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Fixes" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Repairs for common Windows problems. Each one asks first and writes what it does to the log." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <StackPanel x:Name="FixList"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewFeatures" Visibility="Collapsed" VerticalScrollBarVisibility="Visible">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Windows features" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Optional parts of Windows. Ticked means on. Change the ticks and press Apply. Windows needs a restart after a change." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                  <Button x:Name="FeatureApply" Content="Apply changes" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="FeatureRefresh" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
                  <TextBlock x:Name="FeatureStatus" Text="Open this tab to read the current state." Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="FeatureList"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Visible">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Config" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Save what you picked and use it again after the next format." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="WinTool profile" FontWeight="SemiBold"/>
                <TextBlock Text="A profile remembers the apps, tweaks, and terminal choices. Loading it selects them in this window. It does not install anything until you press Install, Apply, or Set up terminal." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="ProfileSummary" Text="Nothing selected yet." Foreground="{DynamicResource BrushInk}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="SaveProfile" Content="Save profile" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="LoadProfile" Content="Load profile" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" Text="To replay a profile from a command after the next format, run PowerShell as admin:  powershell -STA -ExecutionPolicy Bypass -File .\wintool.ps1 -ApplyProfile .\wintool-profile.json -Unattended"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="winget package list" FontWeight="SemiBold"/>
                <TextBlock Text="This is winget's own export file, which can include apps that were not installed by WinTool. Import asks winget to install every package in the file." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ExportWinget" Content="Export winget list" Style="{StaticResource SecondaryButton}" Margin="0"/>
                  <Button x:Name="ImportWinget" Content="Import winget list" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Tweaks" FontWeight="SemiBold"/>
                <TextBlock Text="Some tweaks only show up after File Explorer restarts." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <CheckBox x:Name="TweakRestartExplorer" Content="Restart File Explorer when a tweak needs it" IsChecked="True"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="DNS servers" FontWeight="SemiBold"/>
                <TextBlock Text="Pick which DNS servers a network adapter uses. Automatic goes back to what your router hands out." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,12,8"/>
                  <ComboBox x:Name="DnsAdapter" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="Network adapter"/>
                  <TextBlock Text="DNS" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="DnsProvider" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="DNS provider"/>
                </Grid>
                <CheckBox x:Name="DnsIncludeIpv6" Content="Also set IPv6 DNS servers" IsChecked="True" Margin="0,4,0,8"/>
                <TextBlock x:Name="DnsCurrent" Text="Open this tab to read the current DNS servers." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ApplyDns" Content="Apply DNS" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="RefreshDns" Content="Refresh adapters" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Ultimate Performance power plan" FontWeight="SemiBold"/>
                <TextBlock x:Name="PowerPlanDescription" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="PowerPlanStatus" Text="Checking..." FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AddUltimatePlan" Content="Add and switch to it" Style="{StaticResource SecondaryButton}" Margin="0"/>
                  <Button x:Name="RemoveUltimatePlan" Content="Remove it" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- The log opens over the bottom of the page, so showing it never moves or resizes anything. -->
      <Border x:Name="LogPanel" Grid.Row="0" Height="180" Margin="20,0,20,8" Padding="14,8" VerticalAlignment="Bottom" Panel.ZIndex="10" Background="{StaticResource BrushLog}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
        <TextBox x:Name="LogBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="Transparent" Foreground="{DynamicResource BrushLogText}" CaretBrush="{DynamicResource BrushLogText}" BorderThickness="0" FontFamily="Consolas" Padding="0"/>
      </Border>
      <Border x:Name="StatusBar" Grid.Row="1" Background="{StaticResource BrushLog}" CornerRadius="12" Margin="20,0,20,16" Padding="14,8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource BrushLogText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelRun" Content="Cancel" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
              <Button x:Name="ClearLogButton" Content="Clear log" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
              <Button x:Name="ToggleLogButton" Content="Show log" Style="{StaticResource QuietButton}" MinWidth="84" AutomationProperties.Name="Show log"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="MainProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource BrushProgress}" Background="{DynamicResource BrushProgressTrack}" BorderThickness="0" Margin="0,10,0,0" DockPanel.Dock="Top" Visibility="Hidden"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

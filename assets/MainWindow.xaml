<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Title="WinTool"
    Width="1120"
    Height="800"
    MinWidth="980"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BrushCanvas}" Foreground="{DynamicResource BrushInk}"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="BrushCanvas" Color="#1B2230"/>
    <SolidColorBrush x:Key="BrushCard" Color="#262E40"/>
    <SolidColorBrush x:Key="BrushLine" Color="#3A445C"/>
    <SolidColorBrush x:Key="BrushInk" Color="#E8EDF7"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#A7B3C9"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#6C9BFF"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#2A3A5C"/>
    <SolidColorBrush x:Key="BrushOk" Color="#3DDC97"/>
    <SolidColorBrush x:Key="BrushOkSoft" Color="#17382E"/>
    <SolidColorBrush x:Key="BrushWarn" Color="#E6B15A"/>
    <SolidColorBrush x:Key="BrushWarnSoft" Color="#3A3120"/>
    <SolidColorBrush x:Key="BrushBad" Color="#B42318"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#141A27"/>
    <SolidColorBrush x:Key="BrushLog" Color="#121826"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#8BB0FF"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#4E86F5"/>
    <SolidColorBrush x:Key="BrushSidebarText" Color="#E8EEF8"/>
    <SolidColorBrush x:Key="BrushSidebarMuted" Color="#93A0B8"/>
    <SolidColorBrush x:Key="BrushNavHover" Color="#2A3348"/>
    <SolidColorBrush x:Key="BrushLogText" Color="#D5DEEE"/>
    <SolidColorBrush x:Key="BrushProgress" Color="#6C9BFF"/>
    <SolidColorBrush x:Key="BrushProgressTrack" Color="#2A3348"/>
    <SolidColorBrush x:Key="BrushInput" Color="#1C2434"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#44506A"/>
    <SolidColorBrush x:Key="BrushHint" Color="#8E9BB3"/>
    <SolidColorBrush x:Key="BrushOnAccent" Color="#FFFFFF"/>


    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushSidebarText}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushCanvas}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource BrushLogText}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>



    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource BrushInput}" BorderBrush="{DynamicResource BrushInputBorder}" BorderThickness="1">
                <Path x:Name="Mark" Data="M 2,5 L 6,9 L 12,2" Stroke="{DynamicResource BrushOnAccent}" StrokeThickness="2" Visibility="Collapsed" Margin="3" Stretch="Uniform"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal">
              <Grid Width="18" Height="18" Margin="0,1,8,0" VerticalAlignment="Center">
                <Ellipse x:Name="Ring" Stroke="{DynamicResource BrushInputBorder}" StrokeThickness="1.5" Fill="{DynamicResource BrushInput}"/>
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource BrushAccent}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrushInputBorder}"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushNavHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource BrushMuted}" CornerRadius="4" Margin="2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
          <TextBlock Text="Appearance" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource BrushSidebarMuted}"/>
          <ComboBox x:Name="ThemePicker" Margin="0,0,0,8" AutomationProperties.Name="Theme"/>
          <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Margin="0,0,0,14"/>
          <TextBlock x:Name="VersionText" Text="Version" Foreground="{DynamicResource BrushSidebarMuted}" FontSize="12"/>
          <TextBlock FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource BrushSidebarText}" TextWrapping="Wrap">
            <Hyperlink x:Name="ProjectLink" Foreground="{DynamicResource BrushSidebarText}" NavigateUri="https://github.com/Hinrikao/WinTool">
              Hinrikao/WinTool
            </Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel Margin="16,22,16,0">
          <TextBlock Text="WinTool" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushSidebarText}"/>
          <TextBlock Text="A calm setup helper for a fresh Windows 11 PC." Foreground="{DynamicResource BrushSidebarMuted}" TextWrapping="Wrap" Margin="0,8,0,22" FontSize="13"/>

          <RadioButton x:Name="NavInstall" GroupName="WinToolNav" Style="{StaticResource NavButton}" IsChecked="True" AutomationProperties.Name="Install">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Install" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTweaks" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Tweaks">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTerminal" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Terminal">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Terminal" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavUpdates" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Drivers and updates">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Updates" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFixes" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Fixes">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Fixes" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavFeatures" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Windows features">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Features" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavConfig" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Config">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Config" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid x:Name="ViewInstall">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Text="Install" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Choose the apps you want. WinTool installs them with winget, one at a time, and writes a log below. Right-click an app to update or uninstall just that one." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Wraps onto a second line when the window is narrow, so no button is cut off. -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock x:Name="AppInstalledStatus" Text="Installed apps not checked yet." Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="0,0,16,6"/>
              <Button x:Name="AppRefreshInstalled" Content="Refresh" ToolTip="Check again which apps are installed and which have updates" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
              <Button x:Name="AppSelectInstalled" Content="Select installed" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
              <Button x:Name="AppUpdate" Content="Update selected" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
              <Button x:Name="AppUninstall" Content="Uninstall selected" Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"/>
              <Button x:Name="AppUpgradeAll" Content="Update all" Style="{StaticResource SecondaryButton}" ToolTip="Runs winget upgrade --all" Margin="0,0,8,6"/>
            </WrapPanel>
            <Grid Grid.Column="0">
              <TextBox x:Name="AppSearch" AutomationProperties.Name="Search apps"/>
              <TextBlock x:Name="AppSearchHint" Text="Search apps" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushHint}"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock x:Name="AppCount" Text="0 selected" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="AppSelectVisible" Content="Select visible" Style="{StaticResource SecondaryButton}" Margin="0"/>
              <Button x:Name="AppClear" Content="Clear" Style="{StaticResource SecondaryButton}"/>
              <Button x:Name="AppInstall" Content="Install selected" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="24,0,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock x:Name="AppEmpty" Text="No apps match that search." Foreground="{DynamicResource BrushMuted}" Margin="4,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="AppCategories"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="ViewTweaks" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Text="Tweaks" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Optional changes for a calmer PC. WinTool creates a restore point first. Every tweak here has an undo. Removing an inbox app can be restored only while Windows still has a copy." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <TextBox x:Name="TweakSearch" AutomationProperties.Name="Search tweaks"/>
                <TextBlock x:Name="TweakSearchHint" Text="Search tweaks" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushHint}"/>
              </Grid>
              <WrapPanel x:Name="TweakPresets" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="TweakClear" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0"/>
                <Button x:Name="TweakUndo" Content="Undo selected" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="TweakApply" Content="Apply selected" Style="{StaticResource PrimaryButton}"/>
              </StackPanel>
            </Grid>
            <CheckBox x:Name="TweakRestartExplorer" Grid.Row="1" Content="Restart File Explorer when a tweak needs it" IsChecked="True" Margin="0,12,0,0"/>
          </Grid>
          <Grid Grid.Row="2" Margin="24,0,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="TweakEmpty" Text="No tweaks match that search." Foreground="{DynamicResource BrushMuted}" Margin="4,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="TweakCategories"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <ScrollViewer x:Name="ViewTerminal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="TerminalPage" Margin="20,18,20,0">
            <StackPanel.Resources>
              <Style x:Key="TerminalCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushCard}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushLine}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="15,12,15,0"/>
              </Style>
              <Style x:Key="TerminalCardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="22"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              </Style>
              <Style x:Key="TerminalLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushInk}"/>
              </Style>
              <Style x:Key="TerminalSearch" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="24"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="8,0"/>
              </Style>
              <Style x:Key="TerminalHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="10,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushHint}"/>
              </Style>
              <Style x:Key="TerminalThemeItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Padding" Value="9,1"/>
              </Style>
              <Style x:Key="TerminalFontItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="9,2"/>
              </Style>
            </StackPanel.Resources>
            <TextBlock Text="Terminal" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushInk}"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,11" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource BrushMuted}">
              <RadioButton x:Name="TerminalModeSimple" GroupName="TerminalMode" Content="Simple" IsChecked="True" Margin="0,0,16,0" Foreground="{DynamicResource BrushMuted}" ToolTip="A recommended setup in one click."/>
              <RadioButton x:Name="TerminalModeAdvanced" GroupName="TerminalMode" Content="Advanced" Foreground="{DynamicResource BrushMuted}" ToolTip="Choose the prompt, font, extras, and color scheme."/>
            </StackPanel>
            <StackPanel x:Name="TerminalSimpleHost"/>
            <Grid x:Name="TerminalAdvancedHost" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TerminalColumnLeft" Width="520*" MinWidth="330"/>
                <ColumnDefinition x:Name="TerminalColumnGap" Width="15"/>
                <ColumnDefinition x:Name="TerminalColumnRight" Width="540*" MinWidth="330"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border x:Name="TerminalCardPrompt" Grid.Row="0" Grid.Column="0" Style="{StaticResource TerminalCard}" Height="330" Margin="0,0,0,15">
                <StackPanel>
                  <TextBlock Text="1. Prompt" Style="{StaticResource TerminalCardTitle}"/>
                  <UniformGrid x:Name="TerminalPromptHost" Columns="3" Margin="0,0,-8,0"/>
                  <Grid Margin="0,0,0,2">
                    <TextBlock Text="Theme" Style="{StaticResource TerminalLabel}" HorizontalAlignment="Left"/>
                    <Button x:Name="TerminalRefresh" Content="Refresh from GitHub" Style="{StaticResource QuietButton}" FontSize="10" Padding="4,0" Margin="0" Height="18" HorizontalAlignment="Right" Foreground="{DynamicResource BrushMuted}" ToolTip="Refresh the Nerd Fonts and Oh My Posh lists from GitHub."/>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <TextBox x:Name="TerminalThemeSearch" Style="{StaticResource TerminalSearch}" AutomationProperties.Name="Search prompt themes"/>
                    <TextBlock x:Name="TerminalThemeSearchHint" Text="Search themes&#x2026;" Style="{StaticResource TerminalHint}"/>
                  </Grid>
                  <Grid>
                    <ListBox x:Name="TerminalStyleList" Height="78" ItemContainerStyle="{StaticResource TerminalThemeItem}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="TerminalStyleNote" Text="Themes" FontSize="11" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0" IsHitTestVisible="False"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border x:Name="TerminalCardFont" Grid.Row="0" Grid.Column="2" Style="{StaticResource TerminalCard}" Height="330" Margin="0,0,0,15">
                <StackPanel>
                  <TextBlock Text="2. Font" Style="{StaticResource TerminalCardTitle}"/>
                  <Grid Margin="0,0,0,6">
                    <TextBox x:Name="TerminalFontSearch" Style="{StaticResource TerminalSearch}" Padding="8,0,130,0" AutomationProperties.Name="Search fonts"/>
                    <TextBlock x:Name="TerminalFontSearchHint" Text="Search fonts&#x2026;" Style="{StaticResource TerminalHint}"/>
                    <CheckBox x:Name="TerminalFontNerdOnly" Content="Nerd Fonts only" IsChecked="True" FontSize="11" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" LayoutTransform="0.85,0,0,0.85,0,0"/>
                  </Grid>
                  <ListBox x:Name="TerminalFontList" Height="150" ItemContainerStyle="{StaticResource TerminalFontItem}" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>
                  <TextBlock Text="Preview" Style="{StaticResource TerminalLabel}" Margin="0,0,0,2"/>
                  <Border x:Name="TerminalFontPreview" Background="{DynamicResource BrushLog}" CornerRadius="5" Padding="13,8" Height="70" ClipToBounds="True">
                    <TextBlock x:Name="TerminalFontSample" Text="Font preview" FontSize="13" Foreground="{DynamicResource BrushLogText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Border>

              <Border x:Name="TerminalCardExtras" Grid.Row="1" Grid.Column="0" Style="{StaticResource TerminalCard}" Height="150" Margin="0,0,0,15">
                <StackPanel>
                  <TextBlock Text="3. Extras" Style="{StaticResource TerminalCardTitle}"/>
                  <UniformGrid x:Name="TerminalExtrasHost" Columns="2" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <Border x:Name="TerminalCardScheme" Grid.Row="1" Grid.Column="2" Style="{StaticResource TerminalCard}" Height="150" Margin="0,0,0,15">
                <StackPanel>
                  <TextBlock Text="4. Color scheme" Style="{StaticResource TerminalCardTitle}"/>
                  <UniformGrid x:Name="TerminalSchemeHost" Columns="4" Margin="0,3,-10,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="TerminalSummaryCard" Style="{StaticResource TerminalCard}" MinHeight="110" Padding="15,12,15,12" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="What will be installed and changed" Style="{StaticResource TerminalCardTitle}"/>
                <UniformGrid x:Name="TerminalSummaryHost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Columns="1" Margin="0,2,16,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TerminalSummary" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}"/>
                <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                  <CheckBox x:Name="TerminalEnabled" Content="Replay with a saved profile" IsChecked="True" FontSize="11" Foreground="{DynamicResource BrushMuted}" HorizontalAlignment="Right" Margin="0,0,0,8" LayoutTransform="0.85,0,0,0.85,0,0" ToolTip="Include this terminal setup when a saved WinTool profile is replayed."/>
                  <Button x:Name="TerminalSetup" Content="Apply terminal setup" Style="{StaticResource PrimaryButton}" FontSize="12" FontWeight="Bold" Width="145" Height="34" Padding="0" Margin="0" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Drivers and updates" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="WinTool uses Windows Update and links to the graphics vendor. It does not install driver cleaner or booster tools." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Graphics on this PC" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="GpuSummary" Text="Looking up graphics adapters..." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <WrapPanel x:Name="VendorLinks"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Update mode" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Choose how Windows Update behaves on this PC. WinTool only writes Windows Update policies and service settings, and Default removes them all again." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="UpdateModeCurrent" Text="Current mode: checking..." FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel x:Name="UpdateModeList" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ApplyUpdateMode" Content="Apply mode" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="RevertUpdateMode" Content="Back to default" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Windows Update" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="The scan lists driver updates Windows Update is offering right now. Optional updates are easier to review in Settings. Installing can take a while and may ask for a restart." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <CheckBox x:Name="IncludeSoftwareUpdates" Content="Include software updates, not only drivers" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="ScanDrivers" Content="Scan for updates" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="OpenWindowsUpdate" Content="Open Windows Update" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="OpenOptionalUpdates" Content="Open optional updates" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="InstallScannedUpdates" Content="Install scanned updates" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="UpdateEmpty" Text="No scan yet." Foreground="{DynamicResource BrushMuted}"/>
                <ListBox x:Name="UpdateList" BorderThickness="0" Background="Transparent" MaxHeight="220" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewFixes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Fixes" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Repairs for common Windows problems. Each one asks first and writes what it does to the log." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <StackPanel x:Name="FixList"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewFeatures" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Windows features" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Optional parts of Windows. Ticked means on. Change the ticks and press Apply. Windows needs a restart after a change." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                  <Button x:Name="FeatureApply" Content="Apply changes" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="FeatureRefresh" Content="Refresh" Style="{StaticResource SecondaryButton}"/>
                  <TextBlock x:Name="FeatureStatus" Text="Open this tab to read the current state." Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="FeatureList"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Config" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrushInk}"/>
            <TextBlock Text="Save what you picked and use it again after the next format." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="WinTool profile" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="A profile remembers the apps, tweaks, and terminal choices. Loading it selects them in this window. It does not install anything until you press Install, Apply, or Set up terminal." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="ProfileSummary" Text="Nothing selected yet." Foreground="{DynamicResource BrushInk}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="SaveProfile" Content="Save profile" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="LoadProfile" Content="Load profile" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushMuted}" FontSize="13" Text="To replay a profile from a command after the next format, run PowerShell as admin:  powershell -STA -ExecutionPolicy Bypass -File .\wintool.ps1 -ApplyProfile .\wintool-profile.json -Unattended"/>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="winget package list" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="This is winget's own export file, which can include apps that were not installed by WinTool. Import asks winget to install every package in the file." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ExportWinget" Content="Export winget list" Style="{StaticResource SecondaryButton}" Margin="0"/>
                  <Button x:Name="ImportWinget" Content="Import winget list" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="DNS servers" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="Pick which DNS servers a network adapter uses. Automatic goes back to what your router hands out." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Adapter" VerticalAlignment="Center" Margin="0,0,12,8"/>
                  <ComboBox x:Name="DnsAdapter" Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="Network adapter"/>
                  <TextBlock Text="DNS" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <ComboBox x:Name="DnsProvider" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="DNS provider"/>
                </Grid>
                <CheckBox x:Name="DnsIncludeIpv6" Content="Also set IPv6 DNS servers" IsChecked="True" Margin="0,4,0,8"/>
                <TextBlock x:Name="DnsCurrent" Text="Open this tab to read the current DNS servers." Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ApplyDns" Content="Apply DNS" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="RefreshDns" Content="Refresh adapters" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushLine}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Ultimate Performance power plan" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="PowerPlanDescription" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="PowerPlanStatus" Text="Checking..." FontWeight="SemiBold" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AddUltimatePlan" Content="Add and switch to it" Style="{StaticResource SecondaryButton}" Margin="0"/>
                  <Button x:Name="RemoveUltimatePlan" Content="Remove it" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border x:Name="StatusBar" Grid.Row="1" Background="{StaticResource BrushLog}" CornerRadius="12" Margin="20,0,20,16" Padding="14,8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource BrushLogText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelRun" Content="Cancel" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
              <Button x:Name="ClearLogButton" Content="Clear log" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
              <Button x:Name="ToggleLogButton" Content="Show log" Style="{StaticResource QuietButton}" AutomationProperties.Name="Show log"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="MainProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource BrushProgress}" Background="{DynamicResource BrushProgressTrack}" BorderThickness="0" Margin="0,10,0,0" DockPanel.Dock="Top" Visibility="Collapsed"/>
          <Border x:Name="LogPanel" Height="168" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBox x:Name="LogBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="Transparent" Foreground="{DynamicResource BrushLogText}" CaretBrush="{DynamicResource BrushLogText}" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="0"/>
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

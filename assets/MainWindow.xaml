<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root"
    Title="WinTool"
    Width="1120"
    Height="800"
    MinWidth="980"
    MinHeight="680"
    WindowStartupLocation="CenterScreen"
    Background="#EEF2F7"
    FontFamily="Segoe UI"
    FontSize="14"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="BrushCanvas" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushLine" Color="#E1E8F2"/>
    <SolidColorBrush x:Key="BrushInk" Color="#152033"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#5E6E86"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#2F6FED"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#E7EEFF"/>
    <SolidColorBrush x:Key="BrushOk" Color="#0F7A56"/>
    <SolidColorBrush x:Key="BrushOkSoft" Color="#E5F6EF"/>
    <SolidColorBrush x:Key="BrushWarn" Color="#8A5A00"/>
    <SolidColorBrush x:Key="BrushWarnSoft" Color="#FFF4E0"/>
    <SolidColorBrush x:Key="BrushBad" Color="#B42318"/>
    <SolidColorBrush x:Key="BrushSidebar" Color="#152033"/>
    <SolidColorBrush x:Key="BrushLog" Color="#101826"/>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E7EEF8"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#243044"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2F6FED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#2F6FED"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1D5AD6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#184AAA"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#152033"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#D5DEEA" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F4F7FB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietButton" TargetType="Button">
      <Setter Property="Foreground" Value="#D7E2F0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#243044"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D5DEEA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource BrushSidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
          <TextBlock x:Name="VersionText" Text="Version" Foreground="#8FA0B8" FontSize="12"/>
          <TextBlock FontSize="12" Margin="0,8,0,0" Foreground="#D5E2F2" TextWrapping="Wrap">
            <Hyperlink x:Name="ProjectLink" Foreground="#D5E2F2" NavigateUri="https://github.com/Hinrikao/WinTool">
              Hinrikao/WinTool
            </Hyperlink>
          </TextBlock>
        </StackPanel>
        <StackPanel Margin="16,22,16,0">
          <TextBlock Text="WinTool" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="A calm setup helper for a fresh Windows 11 PC." Foreground="#A9B6C9" TextWrapping="Wrap" Margin="0,8,0,22" FontSize="13"/>

          <RadioButton x:Name="NavInstall" GroupName="WinToolNav" Style="{StaticResource NavButton}" IsChecked="True" AutomationProperties.Name="Install">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Install" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTweaks" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Tweaks">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Tweaks" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTerminal" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Terminal">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Terminal" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavUpdates" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Drivers and updates">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Updates" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavConfig" GroupName="WinToolNav" Style="{StaticResource NavButton}" AutomationProperties.Name="Config">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock Text="Config" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="220"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid x:Name="ViewInstall">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Text="Install" FontSize="28" FontWeight="SemiBold" Foreground="#152033"/>
            <TextBlock Text="Choose the apps you want. WinTool installs them with winget, one at a time, and writes a log below." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <TextBox x:Name="AppSearch" AutomationProperties.Name="Search apps"/>
              <TextBlock x:Name="AppSearchHint" Text="Search apps" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#8A9BB3"/>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <TextBlock x:Name="AppCount" Text="0 selected" Foreground="#5E6E86" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="AppSelectVisible" Content="Select visible" Style="{StaticResource SecondaryButton}" Margin="0"/>
              <Button x:Name="AppClear" Content="Clear" Style="{StaticResource SecondaryButton}"/>
              <Button x:Name="AppInstall" Content="Install selected" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2" Margin="24,0,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock x:Name="AppEmpty" Text="No apps match that search." Foreground="#5E6E86" Margin="4,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="AppCategories"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <Grid x:Name="ViewTweaks" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="24,22,24,0">
            <TextBlock Text="Tweaks" FontSize="28" FontWeight="SemiBold" Foreground="#152033"/>
            <TextBlock Text="Optional changes for a calmer PC. WinTool creates a restore point first. Every tweak here has an undo. Removing an inbox app can be restored only while Windows still has a copy." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1" Margin="24,16,24,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <TextBox x:Name="TweakSearch" AutomationProperties.Name="Search tweaks"/>
                <TextBlock x:Name="TweakSearchHint" Text="Search tweaks" IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#8A9BB3"/>
              </Grid>
              <WrapPanel x:Name="TweakPresets" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="TweakClear" Content="Clear" Style="{StaticResource SecondaryButton}" Margin="0"/>
                <Button x:Name="TweakUndo" Content="Undo selected" Style="{StaticResource SecondaryButton}"/>
                <Button x:Name="TweakApply" Content="Apply selected" Style="{StaticResource PrimaryButton}"/>
              </StackPanel>
            </Grid>
            <CheckBox x:Name="TweakRestartExplorer" Grid.Row="1" Content="Restart File Explorer when a tweak needs it" IsChecked="True" Margin="0,12,0,0"/>
          </Grid>
          <Grid Grid.Row="2" Margin="24,0,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="TweakEmpty" Text="No tweaks match that search." Foreground="#5E6E86" Margin="4,8,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="TweakCategories"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <ScrollViewer x:Name="ViewTerminal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Terminal" FontSize="28" FontWeight="SemiBold" Foreground="#152033"/>
            <TextBlock Text="Install Windows Terminal, PowerShell 7, a prompt, and a Nerd Font. You can add Terminal-Icons, and optionally Ubuntu with zsh." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Prompt" FontWeight="SemiBold" FontSize="16"/>
                <RadioButton x:Name="PromptOhMyPosh" GroupName="WinToolPrompt" IsChecked="True" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="Oh My Posh"/>
                    <TextBlock Text="A colorful prompt with a built-in theme." Foreground="#5E6E86" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PromptStarship" GroupName="WinToolPrompt" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="Starship"/>
                    <TextBlock Text="A small, fast prompt that stays out of the way." Foreground="#5E6E86" FontSize="13"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Font" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="WinTool installs the font and sets it as the Windows Terminal default. If icons look missing, pick the same font inside Terminal settings." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,10"/>
                <ComboBox x:Name="FontPicker" MinHeight="36" AutomationProperties.Name="Nerd Font"/>
              </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Options" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                <CheckBox x:Name="TerminalIconsCheck" Content="Install Terminal-Icons for directory and file icons" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="WslCheck" Content="Install WSL with Ubuntu" Margin="0,0,0,8"/>
                <CheckBox x:Name="ZshCheck" Content="Inside Ubuntu, install zsh and Oh My Zsh" IsEnabled="False" Margin="18,0,0,8"/>
                <TextBlock Text="Turning on WSL can take a few minutes and may ask you to reboot. zsh is installed after Ubuntu is ready." Foreground="#5E6E86" TextWrapping="Wrap" Margin="18,0,0,8" FontSize="13"/>
                <CheckBox x:Name="TerminalEnabled" Content="Include this terminal setup when a saved profile is replayed" IsChecked="True"/>
              </StackPanel>
            </Border>

            <Button x:Name="TerminalSetup" Content="Set up terminal" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewUpdates" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Drivers and updates" FontSize="28" FontWeight="SemiBold" Foreground="#152033"/>
            <TextBlock Text="WinTool uses Windows Update and links to the graphics vendor. It does not install driver cleaner or booster tools." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Graphics on this PC" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="GpuSummary" Text="Looking up graphics adapters..." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <WrapPanel x:Name="VendorLinks"/>
              </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Windows Update" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="The scan lists driver updates Windows Update is offering right now. Optional updates are easier to review in Settings. Installing can take a while and may ask for a restart." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <CheckBox x:Name="IncludeSoftwareUpdates" Content="Include software updates, not only drivers" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="ScanDrivers" Content="Scan for updates" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="OpenWindowsUpdate" Content="Open Windows Update" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="OpenOptionalUpdates" Content="Open optional updates" Style="{StaticResource SecondaryButton}"/>
                  <Button x:Name="InstallScannedUpdates" Content="Install scanned updates" Style="{StaticResource SecondaryButton}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="UpdateEmpty" Text="No scan yet." Foreground="#5E6E86"/>
                <ListBox x:Name="UpdateList" BorderThickness="0" Background="Transparent" MaxHeight="220" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ViewConfig" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24,22,24,12">
            <TextBlock Text="Config" FontSize="28" FontWeight="SemiBold" Foreground="#152033"/>
            <TextBlock Text="Save what you picked and use it again after the next format." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,16"/>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="WinTool profile" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="A profile remembers the apps, tweaks, and terminal choices. Loading it selects them in this window. It does not install anything until you press Install, Apply, or Set up terminal." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,8"/>
                <TextBlock x:Name="ProfileSummary" Text="Nothing selected yet." Foreground="#152033" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="SaveProfile" Content="Save profile" Style="{StaticResource PrimaryButton}" Margin="0"/>
                  <Button x:Name="LoadProfile" Content="Load profile" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#5E6E86" FontSize="13" Text="To replay a profile from a command after the next format, run PowerShell as admin:  powershell -STA -ExecutionPolicy Bypass -File .\wintool.ps1 -ApplyProfile .\wintool-profile.json -Unattended"/>
              </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E1E8F2" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="winget package list" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="This is winget's own export file, which can include apps that were not installed by WinTool. Import asks winget to install every package in the file." Foreground="#5E6E86" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="ExportWinget" Content="Export winget list" Style="{StaticResource SecondaryButton}" Margin="0"/>
                  <Button x:Name="ImportWinget" Content="Import winget list" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource BrushLog}" CornerRadius="12" Margin="20,0,20,16" Padding="14,12">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CancelRun" Content="Cancel" Style="{StaticResource QuietButton}" Visibility="Collapsed"/>
              <Button x:Name="ClearLogButton" Content="Clear log" Style="{StaticResource QuietButton}"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar x:Name="MainProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#7DABFF" Background="#243044" BorderThickness="0" Margin="0,0,0,8" DockPanel.Dock="Top"/>
          <TextBox x:Name="LogBox" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Background="Transparent" Foreground="#D7E2F0" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="0"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

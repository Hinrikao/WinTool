    {
      "id": "disable-diagtrack",
      "name": "Disable the Connected User Experiences service",
      "description": "Stop and disable the DiagTrack service, which sends diagnostic data. Undo sets it back to automatic. This is stronger than the diagnostic-data policy.",
      "category": "Privacy",
      "risk": "caution",
      "refresh": "none",
      "presets": [],
      "apply": {
        "type": "service",
        "name": "DiagTrack",
        "startupType": "Disabled",
        "stop": true
      },
      "undo": {
        "type": "service",
        "name": "DiagTrack",
        "startupType": "Automatic",
        "stop": false
      }
    },
    {
      "id": "disable-compatibility-appraiser",
      "name": "Disable the compatibility appraiser task",
      "description": "Disable a scheduled task that collects app compatibility data. Undo enables the task again.",
      "category": "Privacy",
      "risk": "caution",
      "refresh": "none",
      "presets": [],
      "apply": {
        "type": "scheduled-task",
        "taskPath": "\\Microsoft\\Windows\\Application Experience\\",
        "taskName": "Microsoft Compatibility Appraiser",
        "state": "Disabled"
      },
      "undo": {
        "type": "scheduled-task",
        "taskPath": "\\Microsoft\\Windows\\Application Experience\\",
        "taskName": "Microsoft Compatibility Appraiser",
        "state": "Enabled"
      }
    },

    {
      "id": "minimal",
      "name": "Minimal",
      "description": "File Explorer and dark mode only. Easy to undo."
    },
    {
      "id": "recommended",
      "name": "Recommended",
      "description": "A calmer everyday PC: Explorer, dark mode, fewer suggestions, less telemetry, and a small set of inbox apps removed."
